@model ProductionSite

@{
    ViewData["Title"] = "Удаление участка";
}

<h1>Удаление участка</h1>

<h3>Вы уверены, что хотите удалить этот участок?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Name)</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Description)</dt>
        <dd class="col-sm-10">@Model.Description</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.EquipmentCount)</dt>
        <dd class="col-sm-10">@Model.EquipmentCount</dd>
    </dl>

    @if (Model.EquipmentCount > 0)
    {
        <p class="text-danger">Вместе с участком будет удалено и установленное на нём оборудование.</p>
    }

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Удалить" class="btn btn-danger" /> |
        <a asp-action="Index">К списку</a>
    </form>
</div>
